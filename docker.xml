<?xml version="1.0" encoding="UTF-8"?>
<project name="creativeshop-frontend" default="tests" basedir=".">

    <property name="theme-name" value="creativeshop"/>
    <property name="docker_container_name" value="magesuite-run-tests-${project}${BUILD_NUMBER}"/>
    <property name="testing_docker_timeout" value="2h"/>

    <target name="docker:cleanup" hidden="true">
        <exec executable="${docker_bin}" checkreturn="false">
            <arg value="rm"/>
            <arg value="-r"/>
            <arg value="${docker_container_name}"/>
        </exec>
    </target>

    <target name="docker:start" depends="docker:cleanup" hidden="true">
        <echo message="Using docker image '${testing_docker_image}:${testing_docker_tag}'"/>

        <exec executable="${docker_bin}" passthru="true" level="error">
            <arg value="pull"/>
            <arg value="${testing_docker_image}:${testing_docker_tag}"/>
        </exec>

        <exec executable="${docker_bin}" checkreturn="true" dir="${project_dir}" passthru="true" level="error">
            <arg value="run"/>
            <arg line="--rm --detach --name ${docker_container_name} --tmpfs /tmp:rw,exec,mode=1777 --tmpfs /var/lib/mysql:rw,mode=777 --tmpfs /var/lib/elasticsearch:rw,mode=777 --tmpfs /var/www/html/generated:rw,mode=777 --tmpfs /var/www/html/var:rw,mode=777 --tmpfs /var/www/html/dev/tests/integration/tmp:rw,mode=777 --volume `pwd`:/var/www/html -e ES_JAVA_OPTS='-Xms256m -Xmx256m' -e CONTAINER_TIMEOUT='${testing_docker_timeout}' ${testing_docker_image}:${testing_docker_tag}"/>
        </exec>

        <echo message="Waiting for container healthcheck to become green..."/>

        <exec executable="bash" checkreturn="true" dir="${project_dir}" passthru="true" level="error">
            <arg value="-c"/>
            <arg line="'while [[ &quot;$(docker inspect --format=&quot;{{json .State.Health.Status}}&quot; ${docker_container_name})&quot; == &quot;\&quot;starting\&quot;&quot; ]]; do sleep 0.5s; done'"/>
        </exec>
    </target>

    <target name="docker:tests">
        <trycatch>
            <try>
                <phingcall target="docker:start"/>
                <phingcall target="magento:build"/>

                <exec executable="${docker_bin}" checkreturn="true" dir="${project_dir}" passthru="true" level="error">
                    <arg line="exec --tty ${docker_container_name} /usr/bin/mgs-run-tests ${envname} ${testsuite} $(id -u) $(id -g)"/>
                </exec>
            </try>

            <finally>
                <phingcall target="docker:cleanup"/>
            </finally>
        </trycatch>
    </target>
</project>
