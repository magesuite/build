<?xml version="1.0" encoding="UTF-8"?>
<project name="hyva-frontend" default="tests" basedir=".">

    <property name="theme-name" value="creativeshop"/>

    <target name="hyva:build">
        <fail message="Please define ordered theme list using the `themes` property!">
            <condition>
                <not>
                    <isset property="themes"/>
                </not>
            </condition>
        </fail>
        <foreach list="${themes}" param="theme-name" target="hyva:build-theme"/>
    </target>

    <target name="hyva:build-theme" hidden="true">
        <echo message="Building theme ${theme-name}..."/>

        <copy todir="${project_dir}/app/design/frontend/creativestyle/theme-${theme-name}">
            <fileset dir="${project_dir}/vendor/creativestyle/theme-${theme-name}/src"/>
        </copy>
        <exec dir="${project_dir}/app/design/frontend/creativestyle/theme-${theme-name}/web/tailwind"
              executable="npm" escape="false" passthru="true" checkreturn="true">
            <arg value="ci"/>
        </exec>
        <exec dir="${project_dir}/app/design/frontend/creativestyle/theme-${theme-name}/web/tailwind"
              executable="npm" escape="false" passthru="true" checkreturn="true">
            <arg value="run"/>
            <arg value="build"/>
        </exec>
        <exec dir="${project_dir}/app/design/frontend/creativestyle/theme-${theme-name}/web/tailwind"
              executable="rm" escape="false" passthru="true" checkreturn="true">
            <arg value="-rf"/>
            <arg value="node_modules/"/>
        </exec>
    </target>
</project>
